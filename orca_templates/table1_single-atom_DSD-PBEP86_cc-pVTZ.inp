! B2PLYP D3BJ RIJK cc-pVTZ cc-pVTZ/C def2/JK TIGHTSCF
%method
Exchange x_PBE
Correlation c_P86
LDAOpt C_VWN5
ScalHFX 0.69
ScalDFX 0.31
ScalGGAC 0.44
ScalLDAC 0.44
ScalMP2C 1.00
end
%method
D3S6 0.48
D3A1 0.0
D3S8 0.0
D3A2 5.6
end
%mp2
RI on
DoSCS True
Ps 0.52
Pt 0.22
end
%maxcore 4000
%pal
nprocs 1
end
%scf
AutoTRAH false
maxiter 1000
end
# single atom at the origin, UKS ground-state multiplicity:
#   H 2, C 3, N 4, O 3, F 2, Si 3, P 4, S 3, Cl 2   (O shown)
* xyz 0 3
  O  0.0 0.0 0.0
*
